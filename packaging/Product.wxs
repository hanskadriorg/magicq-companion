<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX 4/5 MSI for MagicQ Companion.
  Build after PyInstaller (dist\MagicQCompanion\ must exist):

    wix build packaging\Product.wxs -d PayloadDir=dist\MagicQCompanion -o dist\MagicQCompanion.msi

  Or let the GitHub Action do it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="MagicQ Companion"
      Manufacturer="magicq-companion"
      Version="0.1.0"
      UpgradeCode="8F3C2A1E-9B47-4D6F-A1E2-7C0D5B9E4F21"
      Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Title="MagicQ Companion" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MagicQ Companion" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MagicQ Companion" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PayloadDir)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut
          Id="AppShortcut"
          Name="MagicQ Companion"
          Target="[INSTALLFOLDER]MagicQCompanion.exe"
          WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveProgramsFolder" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\magicq-companion"
          Name="Installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>
  </Package>
</Wix>
